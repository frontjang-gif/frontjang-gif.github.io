---
---
[
  {% assign searchable_documents = site.posts | concat: site.generated %}
  {% for post in searchable_documents %}
    {
      "title": {{ post.title | default: post.excerpt | strip_html | strip | jsonify }},
      "url": {{ post.url | prepend: site.baseurl | jsonify }},
      "category": {{ post.categories | join: ", " | jsonify }},
      "date": {{ post.date | date: "%B %e, %Y" | jsonify }},
      "type": {% if post.collection == "generated" %}"index"{% elsif post.path contains "_posts/Music/" %}"album"{% elsif post.path contains "_posts/Movie/" %}"movie"{% else %}"post"{% endif %}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
